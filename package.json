{
  "name": "leo-field-notes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4521",
    "start": "astro dev --host 127.0.0.1 --port 4521",
    "i18n:posts": "node scripts/generate_english_posts.mjs",
    "topics:normalize": "node scripts/normalize_post_topics.mjs",
    "i18n:check": "node scripts/check_english_posts.mjs",
    "sync:check": "node scripts/crosspost/cli.mjs check",
    "sync:plan": "node scripts/crosspost/cli.mjs plan",
    "sync:login": "node scripts/crosspost/cli.mjs login",
    "sync:publish": "node scripts/crosspost/cli.mjs publish",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "lucide-astro": "^0.556.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "pagefind": "latest",
    "playwright-core": "^1.62.0",
    "typescript": "latest"
  }
}
