---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts } from '../../../lib/posts';

const lang = 'en';
const posts = await getPublishedPosts(lang);
---

<BaseLayout title="All articles" description="Browse all of Leo's technical articles and engineering notes chronologically." lang={lang}>
  <header class="page-header shell">
    <p class="eyebrow">Writing archive</p>
    <h1>All articles</h1>
    <p>{posts.length} notes in total, sorted by publication date and updated as they evolve.</p>
  </header>
  <section class="section shell">
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} order={index + 1} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
