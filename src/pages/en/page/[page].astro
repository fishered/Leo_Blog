---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getPublishedPosts, type Post } from '../../../lib/posts';
import type { GetStaticPaths, Page } from 'astro';

const pageSize = 9;
const lang = 'en';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts('en');
  return paginate(posts, { pageSize: 9, props: { allPosts: posts } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  allPosts: Post[];
}
const { page, allPosts } = Astro.props;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
---

<BaseLayout title={`Posts page ${currentPage}`} description={`Leo's Blog posts page ${currentPage}.`} lang={lang}>
  <header class="page-header shell">
    <p class="eyebrow">Writing page {currentPage}</p>
    <h1>Recent posts</h1>
    <p>Sorted by the original publication date. Page {currentPage} of {totalPages}.</p>
  </header>

  <div class="home-layout shell paged-layout">
    <section class="home-posts" aria-label={`Posts page ${currentPage}`}>
      <div class="post-list">
        {page.data.map((post, index) => <PostCard post={post} order={(currentPage - 1) * pageSize + index + 1} lang={lang} />)}
      </div>
      <Pagination currentPage={currentPage} totalPages={totalPages} lang={lang} />
    </section>
    <Sidebar lang={lang} posts={allPosts} />
  </div>
</BaseLayout>
