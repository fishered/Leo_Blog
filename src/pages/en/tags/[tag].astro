---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getAllTags } from '../../../lib/posts';

const lang = 'en';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  return getAllTags(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Topic: ${tag}`} description={`Browse posts about ${tag}.`} lang={lang}>
  <header class="page-header shell">
    <p class="eyebrow">Topic / {tag}</p>
    <h1>{tag}</h1>
    <p>{posts.length} posts under this topic.</p>
  </header>
  <section class="section shell">
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} order={index + 1} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
