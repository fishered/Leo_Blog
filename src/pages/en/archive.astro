---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';
import { postPath } from '../../lib/i18n';

const lang = 'en';
const posts = await getPublishedPosts(lang);
const years = Object.entries(
  posts.reduce<Record<string, typeof posts>>((groups, post) => {
    const year = String(post.data.published.getFullYear());
    (groups[year] ??= []).push(post);
    return groups;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="Archive" description="Browse all posts by year." lang={lang}>
  <header class="page-header shell">
    <p class="eyebrow">Chronological archive</p>
    <h1>Archive</h1>
    <p>Writing leaves not only posts, but also a timeline worth revisiting.</p>
  </header>
  <section class="section shell archive">
    {years.map(([year, yearPosts]) => (
      <div class="archive-year">
        <h2>{year}</h2>
        <div>
          {yearPosts.map((post) => (
            <a href={postPath(post.data.slug, lang)}>
              <time>{formatDate(post.data.published, lang).slice(0, 5)}</time>
              <span>{post.data.title}</span>
              <small>{post.data.tags.slice(0, 2).join(' / ')}</small>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
