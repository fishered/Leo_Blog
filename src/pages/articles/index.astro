---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const lang = 'zh';
const posts = await getPublishedPosts(lang);
---

<BaseLayout title="全部文章" description="按时间浏览 Leo 的全部技术文章与工程笔记。" lang={lang}>
  <header class="page-header shell">
    <p class="eyebrow">Writing archive</p>
    <h1>全部文章</h1>
    <p>一共 {posts.length} 篇记录。按发布时间排列，内容会持续修订。</p>
  </header>
  <section class="section shell">
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} order={index + 1} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
